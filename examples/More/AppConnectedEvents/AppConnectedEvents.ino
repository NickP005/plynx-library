  NOTE:
    Be sure to enable "send app connect command"
    in your Project Settings!
 *************************************************************/

/* Comment this out to disable prints and save space */
#define PLYNX_PRINT Serial

/* Fill-in your Template ID (legacy: not needed for Plynx) */
//#define PLYNX_TEMPLATE_ID   "YourTemplateID"


#include <SPI.h>
#include <Ethernet.h>
#include <PlynxSimpleEthernet.h>

// You should get Auth Token in the Plynx App.
// Go to the Project Settings (nut icon).
char auth[] = "YourAuthToken";

// This is called when Smartphone App is opened
PLYNX_APP_CONNECTED() {
  Serial.println("App Connected.");
}

// This is called when Smartphone App is closed
PLYNX_APP_DISCONNECTED() {
  Serial.println("App Disconnected.");
}


void setup()
{
  // Debug console
  Serial.begin(9600);

  Plynx.begin(auth);
}

void loop()
{
  Plynx.run();
}

